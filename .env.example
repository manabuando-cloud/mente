APP_NAME=設備トラブルナビ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# APP_NAME が日本語だと既定のCookie名が "-session" になるので明示する
SESSION_COOKIE=navi_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=navi-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- 設備トラブルナビ ----------------------------------------------------
# Googleログイン（Google Cloud Console → OAuthクライアントID「ウェブアプリケーション」）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
NAVI_ALLOWED_DOMAIN=g.kurashiki-laser.co.jp
# 取込レビュー・Drive連携・削除ができる管理者（カンマ区切り）
NAVI_ADMIN_EMAILS=manabu.ando@g.kurashiki-laser.co.jp
# ローカル開発用ログイン（APP_ENV=local のときのみ有効）
NAVI_DEV_LOGIN=false

# Gemini（Google AI Studioで発行。無料枠はクォータが厳しいので従量課金推奨）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Slack Incoming Webhook（未設定なら通知しない）
SLACK_WEBHOOK_URL=

# Google Drive（サービスアカウントのJSONキー。共有ルートフォルダを閲覧者として共有しておく）
GOOGLE_APPLICATION_CREDENTIALS=
NAVI_INGEST_BATCH_LIMIT=15
NAVI_PHOTOS_DISK=public
