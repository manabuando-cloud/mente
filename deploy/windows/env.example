# deploy/windows/.env の雛形（setup.sh が APP_KEY と管理者パスコードを入れて作る）
APP_NAME=設備トラブルナビ
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# 社外公開のURL（Cloudflare Tunnel / ngrok で決めたもの）。社内だけなら http://<PC名>:8080
APP_URL=http://localhost:8080
APP_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo
LOG_CHANNEL=stderr

SESSION_DRIVER=database
SESSION_COOKIE=navi_session
# https で公開したら true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
CACHE_PREFIX=navi-cache-
QUEUE_CONNECTION=database
TRUSTED_PROXIES=*

# ログイン方式: open = URLを知っている人なら誰でも（名前だけ入力。管理機能は管理者パスコード）
NAVI_AUTH_MODE=open
NAVI_ADMIN_PASSCODE=

# Gemini 無料枠（Google AI Studio でキーを発行。課金登録は不要）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 無料枠の回数制限に当たらないよう、呼び出しの間を7秒空ける
GEMINI_MIN_INTERVAL_MS=7000
NAVI_INGEST_BATCH_LIMIT=15

# Slack Incoming Webhook（任意）
SLACK_WEBHOOK_URL=

# Google Drive（サービスアカウントのJSONキー。deploy/windows/secrets/google-drive.json に置く）
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/storage/app/secrets/google-drive.json

# バックアップの保存先（Windows の C:\setsubi-navi-backup）
BACKUP_DIR=/mnt/c/setsubi-navi-backup
NAVI_BACKUP_KEEP_DAYS=30

# 社外公開（どちらか）
TUNNEL_TOKEN=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
