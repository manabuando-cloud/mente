# deploy/cloudrun/config.env にコピーして編集する（config.env は git に入れない）
PROJECT_ID=your-gcp-project-id
REGION=asia-northeast1                # 東京

# 最初は「URLを知っている人なら誰でも使える」モード。Google ログインに切り替えるときは google
AUTH_MODE=open
# 管理者パスコードを自分で決めたい場合（空なら setup で自動生成して表示）
ADMIN_PASSCODE=

# あれば setup 時に Secret Manager に入る（後から入れても良い）
GEMINI_API_KEY=
SLACK_WEBHOOK_URL=

# Google ログイン（AUTH_MODE=google）にするとき。クライアントシークレットは
#   printf '%s' 'xxx' | gcloud secrets create navi-google-client-secret --data-file=-
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=g.kurashiki-laser.co.jp
ADMIN_EMAILS=

# 任意
# DB_TIER=db-f1-micro
# INGEST_BATCH_LIMIT=15
# DAILY_SCHEDULE="10 2 * * *"
