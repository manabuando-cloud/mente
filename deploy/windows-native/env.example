# 設備トラブルナビ（Windows 直接インストール版）の設定
# このファイルは C:\setsubi-navi\config\.env としてコピーされる。書き換えたら
#   .\navi.ps1 restart
# で反映する（メモ帳で開いて保存してよい）

APP_NAME=設備トラブルナビ
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# 公開URL（ngrok の固定ドメイン）。Google ログインはこのURLか http://localhost:8080 で使う
APP_URL=http://localhost:8080
APP_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=C:/setsubi-navi/data/navi.sqlite
DB_JOURNAL_MODE=wal
DB_BUSY_TIMEOUT=10000
DB_SYNCHRONOUS=normal

SESSION_DRIVER=database
SESSION_COOKIE=navi_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
CACHE_PREFIX=navi-cache-
QUEUE_CONNECTION=database
TRUSTED_PROXIES=*

# ログイン: 会社の Google アカウント（@g.kurashiki-laser.co.jp）だけ
NAVI_AUTH_MODE=google
NAVI_ALLOWED_DOMAIN=g.kurashiki-laser.co.jp
NAVI_ADMIN_EMAILS=manabu.ando@g.kurashiki-laser.co.jp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVI_ADMIN_PASSCODE=

# 公開URL（ngrok 無料の固定ドメイン）
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Gemini 無料枠（Google AI Studio でキーを発行）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_INTERVAL_MS=7000
NAVI_INGEST_BATCH_LIMIT=15

# Slack Incoming Webhook（任意）
SLACK_WEBHOOK_URL=

# Google Drive（サービスアカウントの鍵をこの場所に置く）
GOOGLE_APPLICATION_CREDENTIALS=C:/setsubi-navi/config/google-drive.json

NAVI_BACKUP_PATH=C:/setsubi-navi/backup
NAVI_BACKUP_KEEP_DAYS=30
NAVI_PHOTOS_DISK=public
