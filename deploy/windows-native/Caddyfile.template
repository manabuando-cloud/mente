# 設備トラブルナビ Web サーバー（Caddy）。install.ps1 が {{ROOT}} と {{PHP_UPSTREAMS}} を置き換えて config に置く
{
	admin off
	auto_https off
	servers {
		# ngrok（同じPCの 127.0.0.1 から来る）が付ける X-Forwarded-Proto: https をそのまま PHP に渡す
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * {{ROOT}}/app/public
	encode gzip
	request_body {
		max_size 128MB
	}
	header /build/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	php_fastcgi {{PHP_UPSTREAMS}} {
		lb_policy least_conn
		read_timeout 600s
		write_timeout 600s
	}
	file_server
	log {
		output file {{ROOT}}/logs/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
